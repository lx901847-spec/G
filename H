    CardText.TextSize = 13
    CardText.Font = Enum.Font.Kanit
    CardText.TextXAlignment = Enum.TextXAlignment.Left
    CardText.Parent = ButtonCard

    ButtonCard.MouseButton1Click:Connect(function()
        if callback then
            callback()
        end
    end)
end

