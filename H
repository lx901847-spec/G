    CardStroke.Parent = ButtonCard

    local CardText = Instance.new("TextLabel")
    CardText.Size = UDim2.new(1, -10, 1, 0)
    CardText.Position = UDim2.new(0, 10, 0, 0)
    CardText.BackgroundTransparency = 1
